// 幼兒園履歷（工程執行計劃 6.6）：只有靜態資產、沒有 Worker 程式碼。
//
// 沒有 `main` 就不會有 Worker 呼叫——靜態資產請求免費且不計入免費方案的
// 每日 10 萬次上限。日後若要加動態端點（B 端試用 API、LINE webhook），
// 補上 `main` 即可，未命中靜態檔的請求才會落到 Worker；
// **不要開 run_worker_first**，那會讓所有請求都吃呼叫額度，且額度用盡時
// 回 429 而不是退回送靜態檔（見第六階段技術決策表）。
{
  "name": "preschool-resume",
  "compatibility_date": "2026-08-09",
  // 自訂網域由 wrangler 建立，不必自己設 DNS 或憑證；前提是 ggggg.app 這個
  // zone 已在同一個 Cloudflare 帳號下。`.app` 在 HSTS preload 清單上，強制 HTTPS。
  "routes": [{ "pattern": "preschool.ggggg.app", "custom_domain": true }],
  // 關掉 workers.dev 子網域：同一份內容掛在兩個網址會產生重複內容，
  // 且日後只想維護一個正式網址。
  "workers_dev": false,
  "assets": {
    "directory": "./build/site/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
