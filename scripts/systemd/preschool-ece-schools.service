# 幼兒園主檔月更（部署於 old-mini）
# 安裝：sudo cp scripts/systemd/preschool-ece-schools.* /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now preschool-ece-schools.timer
[Unit]
Description=幼兒園主檔月更（教保網基本資料查詢）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shinder
ExecStart=/bin/bash /home/shinder/preschool-resume/scripts/local_ece_schools.sh
TimeoutStartSec=8h
