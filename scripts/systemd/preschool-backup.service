# 教保網裁罰備份（部署於 old-mini）
# 安裝：sudo cp scripts/systemd/preschool-backup.* /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now preschool-backup.timer
[Unit]
Description=幼兒園裁罰公告備份（教保網）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shinder
ExecStart=/bin/bash /home/shinder/preschool-resume/scripts/local_backup.sh
TimeoutStartSec=4h
